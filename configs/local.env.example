# Copy to configs/local.env and edit.

# PYTHON=python3
GPUS=0,1,2,3

# Paper SFT checkpoints (UltraChat), not base or Instruct models.
MODEL_QWEN=glorgao/Qwen2.5-7B-SFT
MODEL_LLAMA=princeton-nlp/Llama-3-Base-8B-SFT

# Paper main setting: τ=20, top-30k. Ablation: TAUS=10,20,30
TOP_K=30000
TAUS=20

# OpenRLHF DPO (Appendix G). Global batch 128 = n_gpu * MICRO_BATCH * grad_accum.
# LR=5e-7
# BETA=0.01
# MICRO_BATCH=2
# ZERO_STAGE=3

# Optional DPO example order after filtering (Table 2): none | easy-to-hard | hard-to-easy
# CURRICULUM=none
